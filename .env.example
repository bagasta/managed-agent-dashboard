# Set saat build/deploy. User dashboard tidak pernah melihat key ini —
# dashboard otomatis menyertakannya di header X-API-Key untuk panggil
# endpoint yang butuh auth (/v1/agents, /v1/models, dst).
VITE_API_KEY=your-admin-api-key-here

VITE_PAYMENT_WEBHOOK_URL=/payment-webhook
