FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_KEY=
ARG VITE_PAYMENT_WEBHOOK_URL=
ARG VITE_PAYMENT_CREATE_CHECKOUT_URL=
ARG VITE_PAYMENT_PLAN_TIER_1_AMOUNT=
ARG VITE_PAYMENT_PLAN_TIER_2_AMOUNT=
ARG VITE_PAYMENT_PLAN_TIER_3_AMOUNT=
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_PAYMENT_WEBHOOK_URL=$VITE_PAYMENT_WEBHOOK_URL
ENV VITE_PAYMENT_CREATE_CHECKOUT_URL=$VITE_PAYMENT_CREATE_CHECKOUT_URL
ENV VITE_PAYMENT_PLAN_TIER_1_AMOUNT=$VITE_PAYMENT_PLAN_TIER_1_AMOUNT
ENV VITE_PAYMENT_PLAN_TIER_2_AMOUNT=$VITE_PAYMENT_PLAN_TIER_2_AMOUNT
ENV VITE_PAYMENT_PLAN_TIER_3_AMOUNT=$VITE_PAYMENT_PLAN_TIER_3_AMOUNT

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
