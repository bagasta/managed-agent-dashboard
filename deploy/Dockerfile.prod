FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_KEY=
ARG VITE_PAYMENT_WEBHOOK_URL=
ARG VITE_DOKU_PAYMENT_LINK_TIER_1=
ARG VITE_DOKU_PAYMENT_LINK_TIER_2=
ARG VITE_DOKU_PAYMENT_LINK_TIER_3=
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_PAYMENT_WEBHOOK_URL=$VITE_PAYMENT_WEBHOOK_URL
ENV VITE_DOKU_PAYMENT_LINK_TIER_1=$VITE_DOKU_PAYMENT_LINK_TIER_1
ENV VITE_DOKU_PAYMENT_LINK_TIER_2=$VITE_DOKU_PAYMENT_LINK_TIER_2
ENV VITE_DOKU_PAYMENT_LINK_TIER_3=$VITE_DOKU_PAYMENT_LINK_TIER_3

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
